# Базовая структура и пользователи локального каталога (dc=example,dc=com)
# Пароль для всех LDAP-пользователей: password

# Организационные подразделения
dn: ou=People,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: People

dn: ou=Groups,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: Groups

# Представительство BionicPRO в другой стране
dn: ou=Foreign,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: Foreign
description: BionicPRO foreign representation

dn: ou=People,ou=Foreign,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Foreign,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: Groups

# --- Пользователи (локальный каталог) ---
dn: uid=john.doe,ou=People,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
cn: John
sn: Doe
uid: john.doe
mail: john@example.com
userPassword: password

dn: uid=jane.smith,ou=People,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
cn: Jane
sn: Smith
uid: jane.smith
mail: jane@example.com
userPassword: password

dn: uid=alex.johnson,ou=People,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
cn: Alex
sn: Johnson
uid: alex.johnson
mail: alex@example.com
userPassword: password

# --- Пользователи (зарубежное представительство) ---
dn: uid=hans.mueller,ou=People,ou=Foreign,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
cn: Hans
sn: Mueller
uid: hans.mueller
mail: hans.mueller@bionicpro.de
userPassword: password

dn: uid=maria.garcia,ou=People,ou=Foreign,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
cn: Maria
sn: Garcia
uid: maria.garcia
mail: maria.garcia@bionicpro.es
userPassword: password

dn: uid=admin.foreign,ou=People,ou=Foreign,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
cn: Foreign
sn: Admin
uid: admin.foreign
mail: admin.foreign@bionicpro.de
userPassword: password

# --- Роли (локальный каталог) — имена совпадают с realm roles Keycloak ---
dn: cn=user,ou=Groups,dc=example,dc=com
objectClass: groupOfNames
cn: user
member: uid=jane.smith,ou=People,dc=example,dc=com

dn: cn=prothetic_user,ou=Groups,dc=example,dc=com
objectClass: groupOfNames
cn: prothetic_user
member: uid=alex.johnson,ou=People,dc=example,dc=com
member: uid=john.doe,ou=People,dc=example,dc=com

# --- Роли (зарубежное представительство) — те же cn для единого маппинга ---
dn: cn=user,ou=Groups,ou=Foreign,dc=example,dc=com
objectClass: groupOfNames
cn: user
member: uid=maria.garcia,ou=People,ou=Foreign,dc=example,dc=com

dn: cn=prothetic_user,ou=Groups,ou=Foreign,dc=example,dc=com
objectClass: groupOfNames
cn: prothetic_user
member: uid=hans.mueller,ou=People,ou=Foreign,dc=example,dc=com

dn: cn=administrator,ou=Groups,ou=Foreign,dc=example,dc=com
objectClass: groupOfNames
cn: administrator
member: uid=admin.foreign,ou=People,ou=Foreign,dc=example,dc=com
